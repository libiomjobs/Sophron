<Window x:Class="Sophron.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Sophron.Controls"
        Title="Sophron" Width="1280" Height="800" MinWidth="720" MinHeight="520"
        PreviewKeyDown="OnWindowKeyDown" Closing="OnClosing">
    <DockPanel Margin="16">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button Content="New" Margin="0,0,6,0" Click="OnNewSong" />
            <Button Content="Open…" Margin="0,0,6,0" Click="OnOpenSong" />
            <Button Content="Save" Margin="0,0,6,0" Click="OnSaveSong" />
            <Button Content="Save as…" Margin="0,0,24,0" Click="OnSaveSongAs" />

            <TextBlock Text="Tuning" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="Temperaments" Width="100" Margin="0,0,24,0" SelectionChanged="OnTemperamentChanged" />

            <!-- A0 is the fundamental every step is counted from; A4 is four octaves above it. -->
            <TextBlock Text="A0" VerticalAlignment="Center" Margin="0,0,8,0" />
            <Slider x:Name="FundamentalSlider" Width="220" VerticalAlignment="Center" Margin="0,0,8,0"
                    SmallChange="0.01" LargeChange="0.1" ValueChanged="OnFundamentalSlid" />
            <TextBox x:Name="FundamentalText" Width="72" VerticalAlignment="Center" Margin="0,0,4,0"
                     KeyDown="OnFundamentalKeyDown" LostKeyboardFocus="OnFundamentalTyped" />
            <TextBlock Text="Hz" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBlock x:Name="A4Text" VerticalAlignment="Center" Width="250" Margin="0,0,8,0" />
            <Button Content="A4 432" Tag="432" Margin="0,0,6,0" Click="OnFundamentalPreset" />
            <Button Content="A4 440" Tag="440" Click="OnFundamentalPreset" />
        </WrapPanel>

        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button x:Name="RewindButton" Content="⏮" Width="40" Margin="0,0,6,0" Click="OnRewind" ToolTip="Back to the start" />
            <Button x:Name="PlayButton" Content="▶  Play" Margin="0,0,6,0" Click="OnPlay" ToolTip="Play (Space)" />
            <Button x:Name="RecordButton" Content="●  Record" Margin="0,0,6,0" Click="OnRecord" ToolTip="Record after a bar of count-in" />
            <Button x:Name="StopButton" Content="■  Stop" Margin="0,0,16,0" Click="OnStop" ToolTip="Stop (Space)" />
            <TextBlock x:Name="PositionText" Text="1.1.1" FontFamily="Consolas" FontSize="16" Width="90"
                       VerticalAlignment="Center" Margin="0,0,16,0" />

            <TextBlock Text="Tempo" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="TempoText" Width="60" VerticalAlignment="Center" Margin="0,0,4,0"
                     KeyDown="OnTempoKeyDown" LostKeyboardFocus="OnTempoTyped" />
            <TextBlock Text="BPM" VerticalAlignment="Center" Margin="0,0,16,0" />
            <TextBlock Text="Beats to the bar" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="BeatsPerBarBox" Width="70" Margin="0,0,16,0" SelectionChanged="OnBeatsPerBarChanged" />
            <CheckBox x:Name="MetronomeBox" Content="Metronome" IsChecked="True" VerticalAlignment="Center"
                      Checked="OnMetronomeChanged" Unchecked="OnMetronomeChanged" />
        </WrapPanel>

        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="MIDI input" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="MidiInputs" Width="220" Margin="0,0,6,0" SelectionChanged="OnMidiInputChanged" />
            <Button Content="Reconnect" Margin="0,0,24,0" Click="OnReconnect"
                    ToolTip="Closes and reopens the MIDI inputs, for a keyboard that has gone quiet" />

            <!-- The pitch wheel's reach, in steps of the temperament. -->
            <TextBlock Text="Bend" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="BendRange" Width="140" Margin="0,0,24,0" SelectionChanged="OnBendRangeChanged" />

            <!-- B, D♯ and G lie exactly halfway between two steps of 27-TET, so each needs telling which way to go. -->
            <StackPanel x:Name="Ties" Orientation="Horizontal">
                <TextBlock Text="B" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="BTie" Width="120" Margin="0,0,16,0" SelectionChanged="OnTieChanged" />
                <TextBlock Text="D♯" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="DSharpTie" Width="120" Margin="0,0,16,0" SelectionChanged="OnTieChanged" />
                <TextBlock Text="G" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="GTie" Width="120" Margin="0,0,24,0" SelectionChanged="OnTieChanged" />
            </StackPanel>

            <Button Content="Export Scala files…" Click="OnExportScala" />
        </WrapPanel>

        <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Margin="0,12,0,0" TextTrimming="CharacterEllipsis" />

        <ScrollViewer x:Name="KeyboardScroller" DockPanel.Dock="Bottom" Height="170" Margin="0,12,0,0"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <controls:TemperedKeyboard x:Name="Keyboard" StepPressed="OnStepPressed" StepReleased="OnStepReleased" />
        </ScrollViewer>

        <!-- Editing the notes. The icons come from the font Windows keeps its own icons in. -->
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <WrapPanel.Resources>
                <Style x:Key="Icon" TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
                    <Setter Property="FontSize" Value="15" />
                </Style>
            </WrapPanel.Resources>
            <ToggleButton x:Name="DrawButton" Width="40" Margin="0,0,12,0" Checked="OnDrawModeChanged" Unchecked="OnDrawModeChanged"
                          ToolTip="Draw notes (P): click to draw, drag right to draw longer; right-click rubs a note out">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" />
            </ToggleButton>
            <Button x:Name="UndoButton" Width="40" Margin="0,0,6,0" Click="OnUndo" IsEnabled="False">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE7A7;" />
            </Button>
            <Button x:Name="RedoButton" Width="40" Margin="0,0,16,0" Click="OnRedo" IsEnabled="False">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE7A6;" />
            </Button>

            <TextBlock Text="Snap" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="SnapBox" Width="120" Margin="0,0,6,0" SelectionChanged="OnSnapChanged"
                      ToolTip="Notes drawn, moved and stretched land on this grid; hold Alt while dragging to place them freely" />
            <Button x:Name="QuantiseButton" Content="Quantise" Margin="0,0,16,0" Click="OnQuantise"
                    ToolTip="Pull the chosen notes, or every note if none is chosen, onto the grid (Q)" />

            <TextBlock Text="Velocity" VerticalAlignment="Center" Margin="0,0,8,0" />
            <Slider x:Name="VelocitySlider" Width="140" Minimum="1" Maximum="127" SmallChange="1" LargeChange="8" IsEnabled="False"
                    VerticalAlignment="Center" Margin="0,0,6,0" ValueChanged="OnVelocitySlid"
                    Thumb.DragStarted="OnVelocityDragStarted" Thumb.DragCompleted="OnVelocityDragCompleted"
                    ToolTip="How hard the chosen notes are played" />
            <TextBlock x:Name="VelocityText" Width="40" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ToggleButton x:Name="LaneButton" Content="Lane" IsChecked="True" Margin="0,0,6,0"
                          Checked="OnLaneShownChanged" Unchecked="OnLaneShownChanged"
                          ToolTip="Show the velocity lane under the notes; drag the bar above it to make it taller" />
            <ComboBox x:Name="LaneToolBox" Width="110" Margin="0,0,16,0" SelectionChanged="OnLaneToolChanged"
                      ToolTip="Freehand paints velocities as you drag; Curve places the points of a smooth curve for the notes to follow">
                <ComboBoxItem Content="Freehand" IsSelected="True" />
                <ComboBoxItem Content="Curve" />
            </ComboBox>

            <TextBlock Text="Zoom time" VerticalAlignment="Center" Margin="0,0,6,0" />
            <Button x:Name="ZoomTimeOutButton" Content="−" MinWidth="32" Padding="4,5" Margin="0,0,2,0" Click="OnZoom" Tag="TimeOut" ToolTip="See more time (Ctrl+wheel)" />
            <Button x:Name="ZoomTimeInButton" Content="+" MinWidth="32" Padding="4,5" Margin="0,0,12,0" Click="OnZoom" Tag="TimeIn" ToolTip="See time in more detail (Ctrl+wheel)" />
            <TextBlock Text="steps" VerticalAlignment="Center" Margin="0,0,6,0" />
            <Button x:Name="ZoomStepsOutButton" Content="−" MinWidth="32" Padding="4,5" Margin="0,0,2,0" Click="OnZoom" Tag="StepsOut" ToolTip="Shorter rows, more steps in view (Ctrl+Shift+wheel)" />
            <Button x:Name="ZoomStepsInButton" Content="+" MinWidth="32" Padding="4,5" Click="OnZoom" Tag="StepsIn" ToolTip="Taller rows (Ctrl+Shift+wheel)" />
        </WrapPanel>

        <!-- The roll scrolls itself, keeping its key gutter and bar numbers in place. -->
        <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <controls:PianoRoll x:Name="Roll" PositionChosen="OnPositionChosen" NotesEdited="OnNotesEdited"
                                SelectionChanged="OnRollSelectionChanged" AuditionStarted="OnAuditionStarted" AuditionStopped="OnAuditionStopped" />
        </ScrollViewer>
    </DockPanel>
</Window>
